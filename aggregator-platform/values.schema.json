{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "required": ["external", "auth", "ingressClassName"],
  "properties": {
    "external": {
      "type": "object",
      "required": ["host", "httpPort", "httpsPort"],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "httpPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "httpsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingressClassName": {
      "type": "string",
      "minLength": 1
    },
    "auth": {
      "type": "object",
      "required": ["allowedRegistrationTypes"],
      "properties": {
        "allowedRegistrationTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "none",
              "authorization_code",
              "device_code",
              "provision",
              "client_credentials"
            ]
          }
        },
        "solidOidc": {
          "type": "boolean",
          "default": true
        },
        "oidc": {
          "type": "object",
          "properties": {
            "clientId": {
              "type": "string",
              "minLength": 1
            },
            "clientSecret": {
              "type": "string",
              "minLength": 1
            },
            "server": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "provision": {
          "type": "object",
          "properties": {
            "clientId": {
              "type": "string",
              "minLength": 1
            },
            "clientSecret": {
              "type": "string",
              "minLength": 1
            },
            "webId": {
              "type": "string",
              "minLength": 1
            },
            "authServer": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "client_credentials": {
          "type": "object",
          "properties": {
            "clientId": {
              "type": "string",
              "minLength": 1
            },
            "clientSecret": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },

      "allOf": [
        {
          "if": {
            "properties": {
              "allowedRegistrationTypes": {
                "contains": { "const": "provision" }
              }
            }
          },
          "then": {
            "required": ["provision"],
            "properties": {
              "provision": {
                "required": [
                  "clientId",
                  "clientSecret",
                  "webId",
                  "authServer"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "allowedRegistrationTypes": {
                "contains": { "const": "client_credentials" }
              }
            }
          },
          "then": {
            "required": ["client_credentials"],
            "properties": {
              "client_credentials": {
                "required": ["clientId", "clientSecret"]
              }
            }
          }
        }
      ]
    },

    "tls": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "mode": {
          "type": "string",
          "enum": ["selfsigned", "cert-manager"]
        },
        "secretName": {
          "type": "string",
          "minLength": 1
        },
        "selfSigned": {
          "type": "object",
          "required": ["crt", "key"],
          "additionalProperties": false,
          "properties": {
            "crt": {
              "type": "string",
              "minLength": 1,
              "description": "Base64 encoded TLS certificate"
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "description": "Base64 encoded TLS private key"
            }
          }
        },
        "certManager": {
          "type": "object",
          "required": ["issuerName"],
          "additionalProperties": false,
          "properties": {
            "issuerName": {
              "type": "string",
              "minLength": 1
            },
            "issuerKind": {
              "type": "string",
              "enum": ["Issuer", "ClusterIssuer"],
              "default": "ClusterIssuer"
            },
            "issuerGroup": {
              "type": "string",
              "default": "cert-manager.io"
            },
            "dnsNames": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "duration": {
              "type": "string"
            },
            "renewBefore": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": { "const": true }
            }
          },
          "then": {
            "required": ["mode", "secretName"]
          }
        },
        {
          "if": {
            "properties": {
              "enabled": { "const": true },
              "mode": { "const": "selfsigned" }
            }
          },
          "then": {
            "required": ["selfSigned"],
            "not": { "required": ["certManager"] }
          }
        },
        {
          "if": {
            "properties": {
              "enabled": { "const": true },
              "mode": { "const": "cert-manager" }
            }
          },
          "then": {
            "required": ["certManager"],
            "not": { "required": ["selfSigned"] }
          }
        }
      ]
    }
  }
}
