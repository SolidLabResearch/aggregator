{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "required": ["host", "auth", "ingressClassName"],
  "properties": {
    "host": {
      "type": "string",
      "minLength": 1
    },
    "auth": {
      "type": "object",
      "required": ["clientId", "allowedRegistrationTypes"],
      "properties": {
        "clientId": {
          "type": "string",
          "minLength": 1
        },
        "server": {
          "type": "string",
          "minLength": 1
        },
        "clientSecret": {
          "type": "string",
          "minLength": 1
        },
        "allowedRegistrationTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["none", "provision", "authorization_code"]
          }
        }
      },
      "oneOf": [
        {
          "required": ["server", "clientSecret"]
        },
        {
          "not": {
            "anyOf": [
              { "required": ["server"] },
              { "required": ["clientSecret"] }
            ]
          }
        }
      ]
    }
  }
}
